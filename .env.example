# Content Factory — client-side API keys (Vite exposes VITE_* to the browser).
# Copy this file to `.env` and fill in your own keys.
#
# Google AI Studio (Gemini 1.5 Pro) — used for scenario generation.
VITE_GEMINI_API_KEY=

# Wavespeed (NanoBanana / Kling / InfiniteTalk / Lipsync).
VITE_WAVESPEED_API_KEY=

# Grok / xAI — trend research & Threads posts (has X/Twitter access).
VITE_GROK_API_KEY=

# Minimax — TTS voice generation (optional).
VITE_MINIMAX_API_KEY=

# Captions AI (Mirage) — subtitles (optional).
VITE_CAPTIONS_API_KEY=
